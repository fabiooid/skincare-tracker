# Formulator agent (paid plan in Settings). Mastra reads this automatically.
# Get a key: https://platform.openai.com/api-keys
# Local: put the real key in .env. Cursor Cloud: use Cloud secrets.
# Never commit a real key.
OPENAI_API_KEY=sk-your-key

# Optional. Default: openai/gpt-4o-mini
# If you omit the slash, openai/ is added (gpt-4o-mini → openai/gpt-4o-mini).
# OPENAI_MODEL=openai/gpt-4o-mini

MASTRA_JWT_SECRET=supersecretdevkeythatishs256safe!
DATABASE_URL=file:./data/app.db
PORT=4111
