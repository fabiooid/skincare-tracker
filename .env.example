# Formulator agent — Gemini. Required to try the paid agent.
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional. Default is google/gemini-2.5-flash
GEMINI_MODEL=google/gemini-2.5-flash

# OpenAI — optional later. Leave blank to start with Gemini only.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Default is openai/gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini

MASTRA_JWT_SECRET=supersecretdevkeythatishs256safe!
DATABASE_URL=file:./data/app.db
PORT=4111
